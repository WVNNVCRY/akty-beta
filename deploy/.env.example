# Копия этого файла → deploy/.env (server-setup.sh создаёт его сам со случайными паролями)
POSTGRES_PASSWORD=
JWT_SECRET=
# Домен для HTTPS (A-запись должна указывать на IP сервера). Пусто — работа по http://IP
DOMAIN=
# Telegram-бот (необязательно)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Файлы: local (том на сервере) или s3 (Selectel S3 / Yandex Object Storage)
STORAGE=local
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
