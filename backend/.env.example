DATABASE_URL="postgresql://akty:akty@localhost:5432/akty?schema=public"

# Подпись JWT (токен живёт 30 дней). В production обязателен — без него сервер не стартует.
JWT_SECRET="change-me-long-random-string"
# NODE_ENV=production
PORT=3000

# Хранилище файлов: local (папка STORAGE_DIR) или s3
STORAGE=local
STORAGE_DIR=./storage
# S3: MinIO на dev, Yandex Object Storage на prod (меняется только endpoint)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="ru-central1"
S3_BUCKET="akty-dev"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"

# Telegram-бот (необязательно). Без токена уведомления копятся в системе со статусом доставки PENDING.
# TELEGRAM_BOT_TOKEN=""
# TELEGRAM_WEBHOOK_SECRET=""

# Папка собранного фронтенда (по умолчанию ../dist-api — результат `npm run build:api` в корне)
# WEB_DIR=""
# LOG_ROUTES=1   # подробный лог старта Nest
